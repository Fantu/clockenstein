[Unit]
Description=Clockenstein background service
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.x.clockenstein.Calendar.Service
ExecStart=@bindir@/clockenstein-daemon
Restart=on-failure
RestartSec=2
StandardOutput=append:%h/.xsession-errors
StandardError=append:%h/.xsession-errors
